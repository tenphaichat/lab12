<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Chuỗi kết nối Windows Authentication mặc định cho LocalDB -->
    <add name="QLSinhVienConnection" 
         connectionString="Server=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;Integrated Security=True;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
    
    <!-- Chuỗi kết nối SQL Server Authentication -->
    <add name="QLSinhVienSqlAuth" 
         connectionString="Server=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;User Id=AppUser;Password=P@ssword123!;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />

    <!-- Chuỗi kết nối SQL Server Local / Express -->
    <add name="QLSinhVienLocal" 
         connectionString="Server=.;Initial Catalog=QLSinhVien;Integrated Security=True;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
